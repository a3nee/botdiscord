# SafeGuard Discord bot. Copy to .env (never commit it).
# Bot token from discord.com/developers → your application → Bot.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
# Commands are registered in this guild only.
DISCORD_GUILD_ID=
# Comma-separated role ids allowed to use the commands.
DISCORD_STAFF_ROLE_IDS=
# SafeGuard API (https required except for localhost) and an organization API key created under Integrations.
SAFEGUARD_API_URL=https://api.your-safeguard-host
SAFEGUARD_ORG_ID=
SAFEGUARD_API_KEY=
# Optional: adds dashboard links to replies.
SAFEGUARD_DASHBOARD_URL=https://safeguardac.pt/console

# ---------------------------------------------------------------------------------------------------------------
# Community features. Each one is off until its channel/role is set. The bot needs Manage Channels, Manage Roles,
# Manage Messages and Moderate Members; its role must sit above the roles it gives out.
# ---------------------------------------------------------------------------------------------------------------
# pt (default) or en.
BOT_LANGUAGE=pt
# Public site used for the policy links and always allowed by the anti-link filter.
SITE_URL=https://safeguardac.pt
# Optional moderation log (blocked links, closed tickets).
LOG_CHANNEL_ID=

# Policies panel: an embed with one button per policy. Without POLICY_LINKS it uses SITE_URL/legal/{terms,privacy,dpa,refunds}.
POLICIES_CHANNEL_ID=
# Optional custom buttons: Label=https://...;Other label=https://...
POLICY_LINKS=https://safeguardac.pt/pt/legal/privacy

# Tickets: the panel with category buttons, channels created under TICKET_CATEGORY_ID.
TICKET_PANEL_CHANNEL_ID=
TICKET_CATEGORY_ID=
# Defaults to DISCORD_STAFF_ROLE_IDS.
TICKET_STAFF_ROLE_IDS=
# Transcripts of closed tickets (defaults to LOG_CHANNEL_ID).
TICKET_LOG_CHANNEL_ID=

# Auto role on join. Needs the privileged "Server Members" intent in the Developer Portal.
AUTOROLE_ROLE_IDS=
# Optional different roles for bots that join.
AUTOROLE_BOT_ROLE_IDS=

# Anti-link. Needs the privileged "Message Content" intent. Staff and Manage Messages are always exempt.
ANTILINK_ENABLED=true
ANTILINK_ALLOWED_DOMAINS=youtube.com,youtu.be,twitch.tv
ANTILINK_EXEMPT_ROLE_IDS=
ANTILINK_EXEMPT_CHANNEL_IDS=
# Timeout after this many blocked links within 10 minutes (0 minutes = only delete).
ANTILINK_STRIKES=3
ANTILINK_TIMEOUT_MINUTES=10

# Live feed: one message, edited over time, with the latest anticheat bans and detections.
FEED_CHANNEL_ID=
# 30–3600 seconds.
FEED_INTERVAL_SECONDS=60
# 1–15 lines per list.
FEED_LIMIT=10
FEED_INCLUDE_MANUAL_BANS=false
FEED_SHOW_PLAYER_NAMES=true