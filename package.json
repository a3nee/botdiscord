{
  "name": "safeguard-discord-bot",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "register": "node --env-file-if-exists=.env dist/register.js",
    "start": "node --env-file-if-exists=.env dist/main.js"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
